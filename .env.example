# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/budstack

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outra-chave-aleatoria-de-64-caracteres
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage (local ou S3) ───────────────────────────────────────────────────
STORAGE_TYPE=local
# Para S3 (opcional):
# STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_BUCKET=budstack-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
